# Supabase do projeto (crie em https://app.supabase.com e rode as migrações de supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca exponha ao cliente. Usada só em rotas server-side (upload/download de
# Storage, motor de regras síncrono, worker de contexto do cliente, sync de
# integrações). Bypassa RLS — todo uso deve checar permissão explicitamente.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que autoriza o worker da fila de contexto do cliente
# (/api/jobs/contexto-cliente). Chamando "CRON_SECRET" por convenção: se uma
# env var com esse nome existir no projeto Vercel, o Cron nativo da Vercel
# manda "Authorization: Bearer <valor>" automaticamente. Outros agendadores
# (ex.: o GitHub Action em .github/workflows/) mandam esse header na mão.
CRON_SECRET=

# Google Drive (leitura das pastas de clientes: modelos aprovados + histórico contratual)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_PLANEJAMENTO_PATRIMONIAL_FOLDER_ID=

# ClickUp (leitura da base de clientes e das demandas em andamento)
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
# ID da Lista "Clientes" — descoberto na prática que é o único lugar do
# workspace com cadastro real de cliente (cada tarefa = um cliente); as
# demais Listas são fluxo de trabalho interno por matéria/área.
CLICKUP_LISTA_CLIENTES_ID=

# Análise por ficha (base de conhecimento validada pelo escritório). Sem a chave, a
# análise por ficha fica desligada e o resto do painel funciona normalmente.
# É uma chave de API paga (console.anthropic.com), separada da assinatura do Claude.
ANTHROPIC_API_KEY=
# Opcionais: modelo (padrão claude-opus-5-5) e tempo máximo da chamada em ms (padrão 200000).
ANTHROPIC_MODEL_FICHAS=
ANTHROPIC_TIMEOUT_MS=
